# Public build settings (no secrets). The address the site is served from, with no trailing slash: the canonical links, the
# sitemap, the social cards and the structured data all use it. Change it here when the site moves to its own domain.
VITE_SITE_URL=https://dawitbkportfolio.vercel.app
# IndexNow key (public by design: it is also served at /<key>.txt so search engines can check the pings are yours).
VITE_INDEXNOW_KEY=c534cc476afb9e51d27d45e4048d56f7
# Paste the codes the Google Search Console and Bing Webmaster Tools "HTML tag" options give you, then rebuild.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
